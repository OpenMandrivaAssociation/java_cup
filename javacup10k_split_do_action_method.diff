# This patch splits the main do_action() method in order to solve the JVM memory limitation problem
# (0.11b already splits via UPPERLIMIT; keep a more aggressive limit for large grammars.)
#
--- a/java_cup/emit.java
+++ b/java_cup/emit.java
@@ -364,7 +364,9 @@
 
   /*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/
 
-  static final int UPPERLIMIT = 300;
+  /* split action code into several methods because of the JVM limitation of method size to 64KB (eclipse-pdt)
+   * Keep a more aggressive limit than stock 300 for very large grammars. */
+  static final int UPPERLIMIT = 100;
   /** Emit code for the non-public class holding the actual action code. 
    * @param out        stream to produce output on.
    * @param start_prod the start production of the grammar.
